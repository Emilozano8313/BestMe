# ============================================
# BestMe Mobile — Variables de entorno
# ============================================
# Copia este archivo a .env y ajusta la URL.
# Expo solo expone al bundle las variables con el prefijo EXPO_PUBLIC_.
# Tras cambiarlo hay que reiniciar Expo con:  npx expo start -c

# --- URL del backend (incluye /api al final) ---
#
# Emulador Android:        http://10.0.2.2:8000/api
# Simulador iOS o web:     http://localhost:8000/api
# Teléfono físico en WiFi: http://<IP-LAN-de-tu-PC>:8000/api
#                          (averigua la IP con `ipconfig` en Windows)
# Producción:              https://tu-backend.up.railway.app/api
#
# Ojo: desde un teléfono físico "localhost" es el propio teléfono,
# nunca tu ordenador. Hay que poner la IP de la red local.
EXPO_PUBLIC_API_URL=http://localhost:8000/api
