{
  "expo": {
    "name": "BestMe",
    "slug": "bestme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bestme",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bestme.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "BestMe usa la cámara para analizar tus comidas, estimar tu composición corporal y revisar tu técnica al entrenar.",
        "NSPhotoLibraryUsageDescription": "BestMe accede a tus fotos para que puedas analizar comidas que ya hayas fotografiado."
      }
    },
    "android": {
      "package": "app.bestme.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B1120",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "BestMe usa la cámara para analizar tus comidas y tu composición corporal.",
          "photosPermission": "BestMe accede a tus fotos para que puedas analizar comidas que ya hayas fotografiado."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1120"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
