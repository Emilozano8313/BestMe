# ============================================
# BestMe Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- Application ---
APP_NAME=BestMe
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bestme_user:bestme_secret_2024@db:5432/bestme_db

# --- JWT Authentication ---
# Genera uno nuevo con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# En producción la app se niega a arrancar si sigue el valor por defecto.
JWT_SECRET_KEY=cambia-esto-por-una-clave-generada
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Acepta lista JSON o separada por comas.
# "*" solo vale en desarrollo: con credenciales el navegador lo rechaza,
# y en producción impide arrancar.
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]

# --- IA de visión (Claude) ---
# Consíguela en https://console.anthropic.com -> API Keys
# Sin esta clave la app funciona, pero los análisis de comida y de
# composición corporal devuelven datos de ejemplo marcados como tales.
# ANTHROPIC_API_KEY=sk-ant-...
