# ============================================
# BestMe Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- Application ---
APP_NAME=BestMe
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bestme_user:bestme_secret_2024@db:5432/bestme_db

# --- JWT Authentication ---
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]

# --- External APIs (Phase 4+) ---
# OPENAI_API_KEY=sk-...
# GOOGLE_CLOUD_VISION_KEY=...
# NUTRITIONIX_APP_ID=...
# NUTRITIONIX_APP_KEY=...

# --- Storage (Phase 4+) ---
# S3_BUCKET_NAME=bestme-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
